# The Graph — gateway API key from https://thegraph.com/studio
GRAPH_API_KEY=
NEXT_PUBLIC_GRAPH_GATEWAY=https://gateway.thegraph.com
GRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse

# x402 keyless per-query payment (Base). Funds the mini app's own data reads.
X402_PRIVATE_KEY=
X402_CHAIN=base-sepolia

# Substreams — event-driven triggers. Polling a subgraph means an autonomous
# guard is up to five minutes late, which is a correctness bug for an app that
# spends (prd.md §10). Without this token the trigger path degrades to interval
# polling and `GET /api/stream` reports mode "interval" — it never claims
# block-level latency it does not have.
#
# The token is a JWT, not an API key: https://thegraph.market/dashboard ->
# Create New Key -> copy the value under API TOKEN.
SUBSTREAMS_API_TOKEN=
# Endpoint/package/module are resolved per network from the manifest's `stream`
# block. Set these only to override every app at once.
#   arbitrum-one  https://arb-one.streamingfast.io
#   optimism      https://mainnet.optimism.streamingfast.io
#   base          https://base-mainnet.streamingfast.io
#   mainnet       https://mainnet.eth.streamingfast.io
SUBSTREAMS_ENDPOINT=
SUBSTREAMS_SPKG=
SUBSTREAMS_MODULE=

# 0G Private Computer — OpenAI-compatible
# Key: pc.0g.ai -> Console -> API Keys. Billing is a 0G-token compute ledger
# you deposit into, not a card. No key -> the planner runs its deterministic
# stub and provenance carries no attestation.
ZEROG_API_KEY=
ZEROG_BASE_URL=https://router-api.0g.ai/v1
# Checked against a live GET /v1/models on 2026-07-25. `deepseek-chat-v3` (named
# in prd.md §9) no longer exists on the router. Live alternatives:
# deepseek-v4-flash, qwen3.7-plus, glm-5.1, minimax-m3.
ZEROG_MODEL=0gm-1.0-35b-a3b
# standard | verified | private. Standard is the router's default and is NOT
# guaranteed verifiable, so an attestation may never arrive. Anything we write
# into provenance must come from verified or private routing.
ZEROG_TRUST_MODE=verified
ZEROG_RPC=
ZEROG_DEPLOYER_KEY=

# Fallback while 0G access is pending — same call shape
OPENAI_API_KEY=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# IDENTITY LAYER — everything below is optional.
# With none of it set, publish/resolve run fully mocked: a real CIDv1, a real
# AES-256-GCM encrypted manifest, a deterministic token id, and the complete
# ENSIP-25/26 record set. Each variable independently upgrades one step to live.
# ─────────────────────────────────────────────────────────────────────────────

# ENS — subname issuance
ENS_PARENT_DOMAIN=atlas-apps.eth
# namespace -> Namespace gasless CCIP-Read subnames   (needs NAMESPACE_API_KEY)  <- default
# namestone -> NameStone, same idea                   (needs NAMESTONE_API_KEY)
#              WARNING: NameStone shuts down 2026-08-03.
# onchain   -> NameWrapper + PublicResolver, Sepolia  (needs ENS_REGISTRAR_PRIVATE_KEY)
# mock      -> in-process, always works, resolves nowhere
# offchain  -> whichever offchain backend has a key, preferring Namespace
# Unset -> the strongest backend that is actually configured.
ENS_REGISTRAR_MODE=offchain

# Namespace — key from https://app.namespace.ninja/offchain?activeTab=apiKeys
# Before this works: point the parent 2LD's resolver at Namespace's hybrid
# resolver in the Namespace App. Nothing resolves until that lands.
NAMESPACE_API_KEY=
# Unset -> staging (Sepolia) or production (mainnet) picked from ENS_CHAIN.
NAMESPACE_API_URL=
# Optional: who owns each issued subname. Defaults to the API key's account.
ENS_SUBNAME_OWNER=

# NameStone (fallback). Sepolia is a different BASE PATH, not a query param:
#   mainnet https://namestone.com/api/public_v1
#   sepolia https://namestone.com/api/public_v1_sepolia
# Leave NAMESTONE_API_URL unset and it is picked from ENS_CHAIN for you.
NAMESTONE_API_KEY=
NAMESTONE_API_URL=

# sepolia (default) | mainnet. Never inferred — testnet unless you say so.
ENS_CHAIN=sepolia
ENS_RPC_URL=
# Only for ENS_REGISTRAR_MODE=onchain. Must own the wrapped parent 2LD.
# NOTE: to register the parent on Sepolia you must use
#   TestnetV1PremigrationRegistrar 0xdf60C561Ca35AD3C89D24BbA854654b1c3477078
# ETHRegistrarController is NOT an authorised controller there and register()
# reverts, with available() still returning true. See ens.ts.
ENS_REGISTRAR_PRIVATE_KEY=

# IPFS — manifest pinning. Unset -> a real CIDv1 over a process-local store.
# pinata | w3s | local
#
# SET THIS TO `pinata` BEFORE YOU PUBLISH ANYTHING YOU INTEND TO KEEP, and read
# why, because `local` fails in a way that looks like success and is not
# recoverable afterwards.
#
# In `local` mode the CID is real — correct content addressing over the actual
# bytes — but it is announced to no network, so `contenthash` resolves only from
# the deployment that happens to hold `.atlas/ipfs`. Publishing appears to work,
# ENS records verify, and the manifest fetches, right up until someone else looks.
#
# The trap: a CID is the hash of the bytes, so the ONLY way to make an already
# written `contenthash` resolve is to pin those exact bytes. Lose the local store
# — a fresh clone, a different working directory, a wiped container — and the
# record is permanently dead. Regenerating the manifest yields a DIFFERENT CID,
# which no longer matches what is on chain, and re-pinning cannot help.
#
# This is not hypothetical: three subnames under `atlas-apps.eth` were published
# in `local` mode and their bytes are gone. `ipfs.io` returns 504 for all three
# and always will. `scripts/pin-backfill.ts` recovered the five whose bytes
# survived (re-uploading identical bytes reproduces the same CID, so no ENS record
# had to change) and could do nothing for the other three.
#
# Run `pnpm dlx tsx --env-file=.env.local scripts/pin-backfill.ts --verify` after
# switching, to pin anything already sitting in the local store and read each CID
# back from a gateway that is not yours.
IPFS_MODE=pinata
PINATA_JWT=
W3S_TOKEN=
W3S_PROOF=
IPFS_GATEWAY=https://ipfs.io/ipfs

# 0G Chain — ERC-7857 Agentic ID. Addresses come from
# `cd contracts && forge script script/Deploy.s.sol:Deploy --broadcast`.
# 16602 = Galileo testnet (default). 16601 is the OLD Galileo V3 — not this network.
ZEROG_CHAIN_ID=16602
ZEROG_AGENTIC_ID_ADDRESS=
ZEROG_REGISTRY_ADDRESS=
ZEROG_VERIFIER_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# AGENCY — which key signs, and whether each app has its own.
#
# None of this was documented here while three variables were live in
# .env.local, so the only way to discover the wallet configuration was to read
# `lib/agency/wallet.ts`. Unset, everything below still runs: the mode falls back
# to `stub`, which signs nothing and needs no keys, and the whole
# propose -> policy -> sign -> journal loop demos cold.
# ─────────────────────────────────────────────────────────────────────────────

# stub | session-eoa | smart-account | smart-session   (default: stub)
#   stub          no keys, simulated tx hash, policy enforced server-side
#   session-eoa   real testnet transactions from a non-root key, server-side
#   smart-account ERC-4337, but the session key is an account OWNER
#   smart-session ERC-7579 + Rhinestone. The ONLY mode where the account itself
#                 refuses a call outside the allowlist — needs a funded ERC-7579
#                 account and a bundler, and refuses to provision without them
#                 rather than falling back to something weaker.
AGENCY_WALLET_MODE=stub
AGENCY_RPC_URL=

# PER-APP KEYS. Set this and each mini app gets its own signer, derived as
# keccak("atlas:session-key:<seed>:<appId>") — deterministic, so an app's address
# survives a redeploy, and one secret in the environment still yields a distinct
# funded address per app.
#
# This is the variable to set. prd §4 P3 and §7 both say "each mini app gets its
# own wallet", and §8's argument that an ENS name is a safety primitive depends
# on it: you verify a funded address before funding it, which means nothing if
# funding one app funds all of them.
#
# The trade, stated because it costs you something real: gas funding becomes
# per app. One shared address serving five autonomous apps becomes five
# addresses to drip. Fund the one you demo.
#
# It is a seed, not a key — it is hashed, never used to sign directly. The seed
# still compromises every derived key, so this is isolation BETWEEN APPS, not
# custody. Use AGENCY_WALLET_MODE=smart-session for enforcement the chain does.
AGENT_SESSION_MASTER_SEED=

# LEGACY, and deliberately still supported: one key that signs for every app.
# Only consulted when AGENT_SESSION_MASTER_SEED is unset. Retained because
# switching to derivation changes every app's address, which would strand a
# balance already sitting on a shared one — so the upgrade is opt-in rather than
# a silent break. When this is the active path the app panel and
# `POST /api/agency/register` both report `keyScope: "shared"` and say so on
# screen. With neither set, each app gets a random in-memory key: isolated,
# unfunded, gone on restart, and reported as `ephemeral`.
AGENT_SESSION_PRIVATE_KEY=

# Only for AGENCY_WALLET_MODE=smart-account / smart-session.
AGENCY_ACCOUNT_ADDRESS=

# App endpoints — written into the ENSIP-26 agent-endpoint records.
NEXT_PUBLIC_APP_URL=https://atlas.xyz
MCP_ENDPOINT=https://mcp.atlas.xyz/sse
